{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "disableSizeLimit": false,
    "lib": ["esnext", "dom"],
    "types": [
      "node",
      "vite/client"
    ],
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "types/*.d.ts",
    "types/**/*.d.ts",
    "mock/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "vue.config.ts",
  ]
}
