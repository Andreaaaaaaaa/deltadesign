{
  "name": "@tencent/delta-ui",
  "version": "0.7.43",
  "main": "dist/delta-ui.es.js",
  "module": "dist/delta-ui.es.js",
  "browser": "dist/delta-ui.es.js",
  "license": "MIT",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "storybook": {
    "displayName": "Deltaverse-ui",
    "supportedFrameworks": [
      "vue"
    ]
  },
  "scripts": {
    "serve": "vue-cli-service serve",
    "build:showcase": "vue-cli-service build",
    "deploy": "npm run build:showcase && gh-pages -d dist",
    "dev": "npm i && npm run storybook",
    "build-old": "npm run build:pre && rollup -c",
    "build2": "vue-tsc --noEmit && vite build --config ./vite.lib.config.ts",
    "build": "vite build --config ./vite.lib.config.ts",
    "release": "npm i && node build/release.js",
    "build:cli": "npm run build:pre && vue-cli-service build --target lib --name delta-ui --dest lib src/index.ts",
    "build:pre": "rm -rf dist",
    "build:scss": "sass --no-source-map src/assets/index.scss dist/delta-ui.css",
    "lint": "vue-cli-service lint \"./src/**/*.{js,jsx,vue,ts,tsx}\" --fix",
    "lint:story": "vue-cli-service lint \"./stories/**/*.{js,jsx,vue,ts,tsx}\" --fix",
    "lint:css": "stylelint \"./src/**/*.{html,vue,css,sass,scss}\" --fix",
    "lint:css-story": "stylelint \"./stories/**/*.{html,vue,css,sass,scss}\" --fix",
    "lint:markdown": "markdownlint ./ --ignore node_modules --fix",
    "commit": "cz",
    "storybook": "start-storybook -p 6006",
    "build:docs": "npm run build-storybook -- -o ./dist-docs",
    "build-storybook": "rm -rf storybook-static && build-storybook",
    "test:generate-output": "jest --json --outputFile=.jest-test-results.json",
    "test": "jest --watch",
    "prepare": "husky install",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s"
  },
  "dependencies": {
    "@popperjs/core": "^2.9.3",
    "ag-charts-community": "8.0.6",
    "ag-charts-vue3": "8.0.6",
    "ag-grid-community": "30.0.5",
    "ag-grid-enterprise": "30.0.5",
    "ag-grid-vue3": "30.0.5",
    "clipboard-polyfill": "^4.0.1",
    "dayjs": "^1.9.7",
    "html-table-parser": "^0.0.5",
    "lodash": "^4.17.15",
    "sortablejs": "^1.15.0",
    "tdesign-icons-vue-next": "^0.2.2",
    "tdesign-vue-next": "0.15.2",
    "tinycolor2": "^1.4.2",
    "validator": "^13.5.1",
    "vue": "^3.3.10",
    "vue-class-component": ">= ^8.0.0-beta.3",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@commitlint/cli": "^16.2.3",
    "@commitlint/config-conventional": "^16.2.1",
